{
  "$schema": "./build.config.schema.json",
  "solution": "dotnet/source-generators/SourceGenerators.sln",
  "versionEnv": "GITVERSION_MAJORMINORPATCH",
  "artifactsVersion": "0.1.0",

  "projectGroups": {
    "packages": {
      "sourceDir": "dotnet/source-generators",
      "action": "pack",
      "include": [
        "DI.ConstructorInjection",
        "DI.ConstructorInjection.Attributes",
        "General.AutoProperties",
        "General.AutoProperties.Attributes",
        "General.AutoToString",
        "General.AutoToString.Attributes",
        "General.DisposePattern",
        "General.DisposePattern.Attributes",
        "General.NamespaceUsingScope"
      ],
      "exclude": []
    }
  },

  "packIncludeSymbols": false,
  "packProperties": {
    "GeneratePackageOnBuild": "false"
  },

  "syncLocalNugetFeed": true,
  "localNugetFeedRoot": "C:\\lunar-horse\\packages\\nuget"
}
